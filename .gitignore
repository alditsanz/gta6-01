# Solmar Heat — files that should never be committed.
# Local build and test outputs from the kit harness and the dev server.
out/
outA/
outB/
dist/
build/
coverage/
*.tsbuildinfo

# Node dependencies and package-manager artefacts.
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
.pnpm-store/

# Runtime and editor clutter.
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Local secrets and environment overrides (never commit keys or tokens).
.env
.env.*
!.env.example
